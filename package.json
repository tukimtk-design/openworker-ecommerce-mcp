{
  "name": "openworker-ecommerce-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Openworker to control Chrome/Edge for Shopee, TikTok Shop, and Lazada product management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "test:tools": "node scripts/test-all-tools.js",
    "webboard:dev": "cd webboard && npm run dev",
    "webboard:build": "cd webboard && npm run build",
    "webboard:serve": "cd webboard && npm run preview"
  },
  "keywords": [
    "mcp",
    "openworker",
    "chrome",
    "edge",
    "shopee",
    "tiktok-shop",
    "lazada",
    "ecommerce"
  ],
  "author": "tukimtk-design",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@types/cheerio": "^0.22.35",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.1",
    "playwright": "^1.42.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sqlite3": "^3.1.11",
    "typescript": "^5.3.3"
  }
}
